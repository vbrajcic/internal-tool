# Database Configuration (Local Development)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=asset_management_dev

# MongoDB Configuration (Local Development)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=asset_management_audit_dev

# Auth0 Configuration (Development Mock)
AUTH0_DOMAIN=https://dev-asset-mgmt.auth0.com
AUTH0_AUDIENCE=https://api.asset-management.local
AUTH0_CLIENT_ID=dev_client_id
AUTH0_CLIENT_SECRET=dev_client_secret

# AWS Configuration (Development Mock)
AWS_ACCESS_KEY_ID=dev_access_key
AWS_SECRET_ACCESS_KEY=dev_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=asset-management-dev-bucket
AWS_SES_REGION=us-east-1

# Email Configuration (Development)
EMAIL_PROVIDER=smtp
EMAIL_FROM=dev@asset-management.local

# SMTP Configuration (Mock for development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev
SMTP_PASS=dev

# Application Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# JWT Configuration (Development)
JWT_SECRET=dev-super-secret-jwt-key-for-development-only
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=1000

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

# Performance Configuration
DATABASE_POOL_SIZE=5
DATABASE_CONNECTION_TIMEOUT=5000

# Security Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
SESSION_SECRET=dev-session-secret

# Development Flags
SKIP_AUTH=true
MOCK_EXTERNAL_SERVICES=true
LOG_LEVEL=debug