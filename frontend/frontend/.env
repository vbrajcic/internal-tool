# Auth0 Configuration (Development Mock)
VITE_AUTH0_DOMAIN=https://dev-asset-mgmt.auth0.com
VITE_AUTH0_CLIENT_ID=dev_client_id
VITE_AUTH0_AUDIENCE=https://api.asset-management.local

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api

# Application Configuration
VITE_APP_NAME=Asset Management System (Dev)
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=development

# Feature Flags
VITE_ENABLE_QR_SCANNING=true
VITE_ENABLE_MOBILE_MODE=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_MOCK_AUTH=true

# Performance Configuration
VITE_QR_SCAN_FPS=10
VITE_QR_SCAN_TIMEOUT=2000

# UI Configuration
VITE_THEME_COLOR=#007bff
VITE_COMPANY_NAME=Demo Company